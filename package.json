  },
  "scripts": {
    "watch": "node scripts/watch.mjs",
    "prebuild": "npx ploc --in \"sources/*.pks\" --out \"docs/{file}.md\"",
    "build": "node scripts/build.mjs",
    "postbuild": "workdir/install.sh",
